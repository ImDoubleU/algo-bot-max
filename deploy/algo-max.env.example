# Application
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_TO_RANDOM_VALUE
LOG_LEVEL=INFO

# MAX
MAX_BOT_TOKEN=CHANGE_TO_MAX_BOT_TOKEN
MAX_BOT_USERNAME=CHANGE_TO_MAX_BOT_USERNAME
MAX_API_BASE=https://platform-api2.max.ru
MAX_API_TIMEOUT_SECONDS=15
MAX_POLL_TIMEOUT_SECONDS=30
MAX_BACKEND_API_BASE=http://127.0.0.1:8000/api/v1
MAX_BACKEND_TIMEOUT_SECONDS=15
MAX_MINIAPP_URL=https://bot.example.ru/miniapp
MINIAPP_TOKEN_TTL_SECONDS=2592000
MAX_WEBAPP_AUTH_MAX_AGE_SECONDS=3600
DEFAULT_TENANT_SLUG=n-novgorod
BOT_MODE=webhook
MAX_WEBHOOK_URL=https://bot.example.ru/api/v1/max/webhook
MAX_WEBHOOK_SECRET=CHANGE_TO_RANDOM_ASCII_VALUE
MAX_WEBHOOK_QUEUE_SIZE=500
MAX_DROP_WEBHOOKS_ON_START=false
MAX_ORDER_NOTIFICATIONS_ENABLED=true

# Database and Redis
# Encode special characters in the database password for these URLs.
DATABASE_URL=postgresql+asyncpg://algomax:CHANGE_DB_PASSWORD@127.0.0.1:5432/algo_bot_max
DATABASE_SYNC_URL=postgresql+psycopg://algomax:CHANGE_DB_PASSWORD@127.0.0.1:5432/algo_bot_max
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX_ATTEMPTS=8
RATE_LIMIT_WINDOW_SECONDS=900

# Initial data and workers
INITIAL_SUPERADMIN_MAX_USER_ID=CHANGE_TO_YOUR_MAX_USER_ID
INITIAL_SUPERADMIN_USERNAME=ImDoubleU
APP_TIMEZONE=Europe/Moscow
COURSES_JSON_PATH=data/courses.json
PRODUCT_MEDIA_ROOT=/var/lib/algo-max/product-media
FEEDBACK_WORKER_ENABLED=true
FEEDBACK_WORKER_INTERVAL_SECONDS=60
BACKUP_RETENTION_DAYS=14

# Optional integrations
CRM_ACTIVE_EXPORT_PATH=
CRM_DEPARTED_EXPORT_PATH=
AMOCRM_WEBHOOK_SECRET=CHANGE_TO_RANDOM_ASCII_VALUE
LMS_API_BASE_URL=
LMS_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_ORDERS_SPREADSHEET_ID=
SENTRY_DSN=
