<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
  id="Definitions_AlgoMax"
  targetNamespace="https://algo-max.local/bpmn">

  <bpmn:collaboration id="Collaboration_AlgoMax" name="Algo MAX — обзор процессов">
    <bpmn:participant id="Participant_Setup" name="1. ЗАПУСК И ДАННЫЕ" processRef="Process_Setup" />
    <bpmn:participant id="Participant_Order" name="2. ЗАКАЗ" processRef="Process_Order" />
    <bpmn:participant id="Participant_Teaching" name="3. ЗАНЯТИЕ И AC" processRef="Process_Teaching" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Setup" name="Запуск и данные" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Setup">
      <bpmn:lane id="Lane_Setup_Admin" name="Администратор / директор">
        <bpmn:flowNodeRef>Start_Setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CatalogRoles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixConfig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Setup_System" name="Backend / mini-app">
        <bpmn:flowNodeRef>Task_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Setup" name="Есть VPS, домен и MAX-токен" />
    <bpmn:userTask id="Task_Config" name="Настроить tenant, .env и HTTPS" />
    <bpmn:serviceTask id="Task_Import" name="Проверить CRM XLSX и курсы" />
    <bpmn:exclusiveGateway id="Gateway_Data" name="Данные корректны?" />
    <bpmn:userTask id="Task_FixData" name="Исправить файл или tenant" />
    <bpmn:serviceTask id="Task_SaveData" name="Сохранить учеников, группы и контакты" />
    <bpmn:userTask id="Task_CatalogRoles" name="Настроить склады, товары и роли" />
    <bpmn:serviceTask id="Task_ReadyCheck" name="Проверить БД, данные и webhook" />
    <bpmn:exclusiveGateway id="Gateway_Ready" name="Готово?" />
    <bpmn:userTask id="Task_FixConfig" name="Заполнить недостающие настройки" />
    <bpmn:endEvent id="End_Ready" name="Бот запущен" />

    <bpmn:sequenceFlow id="Setup_1" sourceRef="Start_Setup" targetRef="Task_Config" />
    <bpmn:sequenceFlow id="Setup_2" sourceRef="Task_Config" targetRef="Task_Import" />
    <bpmn:sequenceFlow id="Setup_3" sourceRef="Task_Import" targetRef="Gateway_Data" />
    <bpmn:sequenceFlow id="Setup_4_No" name="Нет" sourceRef="Gateway_Data" targetRef="Task_FixData" />
    <bpmn:sequenceFlow id="Setup_5_Loop" sourceRef="Task_FixData" targetRef="Task_Import" />
    <bpmn:sequenceFlow id="Setup_6_Yes" name="Да" sourceRef="Gateway_Data" targetRef="Task_SaveData" />
    <bpmn:sequenceFlow id="Setup_7" sourceRef="Task_SaveData" targetRef="Task_CatalogRoles" />
    <bpmn:sequenceFlow id="Setup_8" sourceRef="Task_CatalogRoles" targetRef="Task_ReadyCheck" />
    <bpmn:sequenceFlow id="Setup_9" sourceRef="Task_ReadyCheck" targetRef="Gateway_Ready" />
    <bpmn:sequenceFlow id="Setup_10_No" name="Нет" sourceRef="Gateway_Ready" targetRef="Task_FixConfig" />
    <bpmn:sequenceFlow id="Setup_11_Loop" sourceRef="Task_FixConfig" targetRef="Task_ReadyCheck" />
    <bpmn:sequenceFlow id="Setup_12_Yes" name="Да" sourceRef="Gateway_Ready" targetRef="End_Ready" />
  </bpmn:process>

  <bpmn:process id="Process_Order" name="Заказ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Order">
      <bpmn:lane id="Lane_Order_User" name="Ученик / родитель">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectGift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Order_System" name="Backend / склад / кошелек">
        <bpmn:flowNodeRef>Task_Scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateReserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Order_Staff" name="Преподаватель / администратор">
        <bpmn:flowNodeRef>Task_OrderAction</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Order" name="Открыт бот или mini-app" />
    <bpmn:userTask id="Task_Login" name="Войти и выбрать ученика" />
    <bpmn:serviceTask id="Task_Scope" name="Определить роль и доступные данные" />
    <bpmn:userTask id="Task_SelectGift" name="Выбрать подарок и подтвердить корзину" />
    <bpmn:serviceTask id="Task_ValidateReserve" name="Проверить баланс и остаток, создать резерв" />
    <bpmn:exclusiveGateway id="Gateway_OrderAccepted" name="Заказ принят?" />
    <bpmn:userTask id="Task_CorrectOrder" name="Исправить корзину" />
    <bpmn:userTask id="Task_OrderAction" name="Выдать, отменить или принять возврат" />
    <bpmn:serviceTask id="Task_UpdateOrder" name="Обновить склад, AC, статус и уведомления" />
    <bpmn:endEvent id="End_Order" name="Заказ завершен" />

    <bpmn:sequenceFlow id="Order_1" sourceRef="Start_Order" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Order_2" sourceRef="Task_Login" targetRef="Task_Scope" />
    <bpmn:sequenceFlow id="Order_3" sourceRef="Task_Scope" targetRef="Task_SelectGift" />
    <bpmn:sequenceFlow id="Order_4" sourceRef="Task_SelectGift" targetRef="Task_ValidateReserve" />
    <bpmn:sequenceFlow id="Order_5" sourceRef="Task_ValidateReserve" targetRef="Gateway_OrderAccepted" />
    <bpmn:sequenceFlow id="Order_6_No" name="Нет" sourceRef="Gateway_OrderAccepted" targetRef="Task_CorrectOrder" />
    <bpmn:sequenceFlow id="Order_7_Loop" sourceRef="Task_CorrectOrder" targetRef="Task_SelectGift" />
    <bpmn:sequenceFlow id="Order_8_Yes" name="Да" sourceRef="Gateway_OrderAccepted" targetRef="Task_OrderAction" />
    <bpmn:sequenceFlow id="Order_9" sourceRef="Task_OrderAction" targetRef="Task_UpdateOrder" />
    <bpmn:sequenceFlow id="Order_10" sourceRef="Task_UpdateOrder" targetRef="End_Order" />
  </bpmn:process>

  <bpmn:process id="Process_Teaching" name="Занятие и астрокоины" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Teaching">
      <bpmn:lane id="Lane_Teaching_Teacher" name="Преподаватель">
        <bpmn:flowNodeRef>Start_Teaching</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenGroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accrual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleLesson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductLesson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teaching_System" name="Backend / feedback worker">
        <bpmn:flowNodeRef>Task_OwnGroups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveAccrual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Accrual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teaching_Family" name="Родитель / ученик">
        <bpmn:flowNodeRef>Task_ReceiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Feedback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Teaching" name="Открыт кабинет преподавателя" />
    <bpmn:userTask id="Task_OpenGroups" name="Открыть учеников и расписание" />
    <bpmn:serviceTask id="Task_OwnGroups" name="Показать только свои группы" />
    <bpmn:exclusiveGateway id="Gateway_Action" name="Действие" />

    <bpmn:userTask id="Task_Accrual" name="Выбрать причину, сумму и учеников" />
    <bpmn:serviceTask id="Task_SaveAccrual" name="Проверить права и начислить AC" />
    <bpmn:endEvent id="End_Accrual" name="AC начислены" />

    <bpmn:userTask id="Task_ScheduleLesson" name="Настроить курс и расписание" />
    <bpmn:userTask id="Task_ConductLesson" name="Провести занятие" />
    <bpmn:serviceTask id="Task_GenerateFeedback" name="Сформировать обратную связь" />
    <bpmn:userTask id="Task_ReviewFeedback" name="Проверить текст" />
    <bpmn:sendTask id="Task_SendFeedback" name="Отправить через MAX" />
    <bpmn:receiveTask id="Task_ReceiveFeedback" name="Получить обратную связь" />
    <bpmn:endEvent id="End_Feedback" name="ОС доставлена" />

    <bpmn:sequenceFlow id="Teaching_1" sourceRef="Start_Teaching" targetRef="Task_OpenGroups" />
    <bpmn:sequenceFlow id="Teaching_2" sourceRef="Task_OpenGroups" targetRef="Task_OwnGroups" />
    <bpmn:sequenceFlow id="Teaching_3" sourceRef="Task_OwnGroups" targetRef="Gateway_Action" />
    <bpmn:sequenceFlow id="Teaching_4_AC" name="Начислить AC" sourceRef="Gateway_Action" targetRef="Task_Accrual" />
    <bpmn:sequenceFlow id="Teaching_5" sourceRef="Task_Accrual" targetRef="Task_SaveAccrual" />
    <bpmn:sequenceFlow id="Teaching_6" sourceRef="Task_SaveAccrual" targetRef="End_Accrual" />
    <bpmn:sequenceFlow id="Teaching_7_Lesson" name="Занятие и ОС" sourceRef="Gateway_Action" targetRef="Task_ScheduleLesson" />
    <bpmn:sequenceFlow id="Teaching_8" sourceRef="Task_ScheduleLesson" targetRef="Task_ConductLesson" />
    <bpmn:sequenceFlow id="Teaching_9" sourceRef="Task_ConductLesson" targetRef="Task_GenerateFeedback" />
    <bpmn:sequenceFlow id="Teaching_10" sourceRef="Task_GenerateFeedback" targetRef="Task_ReviewFeedback" />
    <bpmn:sequenceFlow id="Teaching_11" sourceRef="Task_ReviewFeedback" targetRef="Task_SendFeedback" />
    <bpmn:sequenceFlow id="Teaching_12" sourceRef="Task_SendFeedback" targetRef="Task_ReceiveFeedback" />
    <bpmn:sequenceFlow id="Teaching_13" sourceRef="Task_ReceiveFeedback" targetRef="End_Feedback" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_AlgoMax">
    <bpmndi:BPMNPlane id="Plane_AlgoMax" bpmnElement="Collaboration_AlgoMax">
      <bpmndi:BPMNShape id="Participant_Setup_di" bpmnElement="Participant_Setup" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#4D176F"><dc:Bounds x="40" y="40" width="1660" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Setup_Admin_di" bpmnElement="Lane_Setup_Admin" isHorizontal="true" bioc:fill="#FFF7D1" bioc:stroke="#A46B00"><dc:Bounds x="70" y="40" width="1630" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Setup_System_di" bpmnElement="Lane_Setup_System" isHorizontal="true" bioc:fill="#F3ECFF" bioc:stroke="#7B2BD9"><dc:Bounds x="70" y="140" width="1630" height="120" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Setup_di" bpmnElement="Start_Setup" bioc:fill="#FFFFFF" bioc:stroke="#4D176F"><dc:Bounds x="105" y="72" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Config_di" bpmnElement="Task_Config" bioc:fill="#FFD52F" bioc:stroke="#705000"><dc:Bounds x="175" y="60" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Import_di" bpmnElement="Task_Import" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="360" y="170" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Data_di" bpmnElement="Gateway_Data" isMarkerVisible="true" bioc:fill="#FFFFFF" bioc:stroke="#6B21A8"><dc:Bounds x="540" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixData_di" bpmnElement="Task_FixData" bioc:fill="#FFF1B0" bioc:stroke="#A46B00"><dc:Bounds x="640" y="60" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveData_di" bpmnElement="Task_SaveData" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="640" y="170" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CatalogRoles_di" bpmnElement="Task_CatalogRoles" bioc:fill="#FFD52F" bioc:stroke="#705000"><dc:Bounds x="825" y="60" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadyCheck_di" bpmnElement="Task_ReadyCheck" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="1010" y="170" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Ready_di" bpmnElement="Gateway_Ready" isMarkerVisible="true" bioc:fill="#FFFFFF" bioc:stroke="#6B21A8"><dc:Bounds x="1190" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixConfig_di" bpmnElement="Task_FixConfig" bioc:fill="#FFF1B0" bioc:stroke="#A46B00"><dc:Bounds x="1290" y="60" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ready_di" bpmnElement="End_Ready" bioc:fill="#FFFFFF" bioc:stroke="#14805E"><dc:Bounds x="1490" y="182" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Setup_1_di" bpmnElement="Setup_1"><di:waypoint x="141" y="90" /><di:waypoint x="175" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_2_di" bpmnElement="Setup_2"><di:waypoint x="310" y="90" /><di:waypoint x="335" y="90" /><di:waypoint x="335" y="200" /><di:waypoint x="360" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_3_di" bpmnElement="Setup_3"><di:waypoint x="495" y="200" /><di:waypoint x="540" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_4_No_di" bpmnElement="Setup_4_No"><di:waypoint x="565" y="175" /><di:waypoint x="565" y="145" /><di:waypoint x="708" y="145" /><di:waypoint x="708" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="575" y="145" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_5_Loop_di" bpmnElement="Setup_5_Loop"><di:waypoint x="708" y="60" /><di:waypoint x="708" y="48" /><di:waypoint x="428" y="48" /><di:waypoint x="428" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_6_Yes_di" bpmnElement="Setup_6_Yes"><di:waypoint x="590" y="200" /><di:waypoint x="640" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="600" y="180" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_7_di" bpmnElement="Setup_7"><di:waypoint x="775" y="200" /><di:waypoint x="800" y="200" /><di:waypoint x="800" y="90" /><di:waypoint x="825" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_8_di" bpmnElement="Setup_8"><di:waypoint x="960" y="90" /><di:waypoint x="985" y="90" /><di:waypoint x="985" y="200" /><di:waypoint x="1010" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_9_di" bpmnElement="Setup_9"><di:waypoint x="1145" y="200" /><di:waypoint x="1190" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_10_No_di" bpmnElement="Setup_10_No"><di:waypoint x="1215" y="175" /><di:waypoint x="1215" y="145" /><di:waypoint x="1358" y="145" /><di:waypoint x="1358" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1225" y="145" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_11_Loop_di" bpmnElement="Setup_11_Loop"><di:waypoint x="1290" y="90" /><di:waypoint x="1265" y="90" /><di:waypoint x="1265" y="245" /><di:waypoint x="1078" y="245" /><di:waypoint x="1078" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Setup_12_Yes_di" bpmnElement="Setup_12_Yes"><di:waypoint x="1240" y="200" /><di:waypoint x="1490" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="1250" y="180" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_Order_di" bpmnElement="Participant_Order" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#4D176F"><dc:Bounds x="40" y="300" width="1660" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Order_User_di" bpmnElement="Lane_Order_User" isHorizontal="true" bioc:fill="#FFF7D1" bioc:stroke="#A46B00"><dc:Bounds x="70" y="300" width="1630" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Order_System_di" bpmnElement="Lane_Order_System" isHorizontal="true" bioc:fill="#F3ECFF" bioc:stroke="#7B2BD9"><dc:Bounds x="70" y="385" width="1630" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Order_Staff_di" bpmnElement="Lane_Order_Staff" isHorizontal="true" bioc:fill="#E8FAF5" bioc:stroke="#14805E"><dc:Bounds x="70" y="470" width="1630" height="80" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Order_di" bpmnElement="Start_Order" bioc:fill="#FFFFFF" bioc:stroke="#4D176F"><dc:Bounds x="105" y="324" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login" bioc:fill="#FFD52F" bioc:stroke="#705000"><dc:Bounds x="175" y="312" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scope_di" bpmnElement="Task_Scope" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="360" y="397" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectGift_di" bpmnElement="Task_SelectGift" bioc:fill="#FFD52F" bioc:stroke="#705000"><dc:Bounds x="545" y="312" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateReserve_di" bpmnElement="Task_ValidateReserve" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="730" y="397" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderAccepted_di" bpmnElement="Gateway_OrderAccepted" isMarkerVisible="true" bioc:fill="#FFFFFF" bioc:stroke="#6B21A8"><dc:Bounds x="910" y="402" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CorrectOrder_di" bpmnElement="Task_CorrectOrder" bioc:fill="#FFF1B0" bioc:stroke="#A46B00"><dc:Bounds x="1010" y="312" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OrderAction_di" bpmnElement="Task_OrderAction" bioc:fill="#DDF7EF" bioc:stroke="#14805E"><dc:Bounds x="1010" y="482" width="135" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateOrder_di" bpmnElement="Task_UpdateOrder" bioc:fill="#EDE0FF" bioc:stroke="#6B21A8"><dc:Bounds x="1200" y="397" width="135" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Order_di" bpmnElement="End_Order" bioc:fill="#FFFFFF" bioc:stroke="#14805E"><dc:Bounds x="1450" y="409" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Order_1_di" bpmnElement="Order_1"><di:waypoint x="141" y="342" /><di:waypoint x="175" y="342" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_2_di" bpmnElement="Order_2"><di:waypoint x="310" y="342" /><di:waypoint x="335" y="342" /><di:waypoint x="335" y="427" /><di:waypoint x="360" y="427" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_3_di" bpmnElement="Order_3"><di:waypoint x="495" y="427" /><di:waypoint x="520" y="427" /><di:waypoint x="520" y="342" /><di:waypoint x="545" y="342" /></bpmndi:BPMNEdge>
