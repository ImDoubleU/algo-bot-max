# Local no-Docker development profile.
# Copy to .env when PostgreSQL/Docker is not available.

# MAX Bot
MAX_BOT_TOKEN=replace_me
MAX_API_BASE=https://platform-api2.max.ru
MAX_API_TIMEOUT_SECONDS=15
MAX_POLL_TIMEOUT_SECONDS=30
MAX_BACKEND_API_BASE=http://127.0.0.1:8000/api/v1
MAX_BACKEND_TIMEOUT_SECONDS=15
DEFAULT_TENANT_SLUG=nizhniy-novgorod-partner-a
MAX_MINIAPP_URL=http://127.0.0.1:8000/miniapp
BOT_MODE=long_polling
MAX_DROP_WEBHOOKS_ON_START=false
MAX_ORDER_NOTIFICATIONS_ENABLED=true
FEEDBACK_WORKER_ENABLED=true
FEEDBACK_WORKER_INTERVAL_SECONDS=60

# Application
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=replace_me
INITIAL_SUPERADMIN_MAX_USER_ID=replace_me
INITIAL_SUPERADMIN_USERNAME=ImDoubleU
COURSES_JSON_PATH=data/courses.json

# Persistent SQLite database for local runs
DATABASE_URL=sqlite+aiosqlite:///./data/algo_bot.sqlite3
DATABASE_SYNC_URL=sqlite:///./data/algo_bot.sqlite3

# Redis is optional locally
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX_ATTEMPTS=8
RATE_LIMIT_WINDOW_SECONDS=900

# Optional integrations
CRM_ACTIVE_EXPORT_PATH=
CRM_DEPARTED_EXPORT_PATH=
LMS_API_BASE_URL=
LMS_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_ORDERS_SPREADSHEET_ID=
LOG_LEVEL=INFO
SENTRY_DSN=
